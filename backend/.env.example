# AI provider: mock | openai | gemini   (mock needs no key and runs the full demo)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Supabase (optional for MVP; in-memory repo is used when unset)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Embeddings: hash | sentence-transformers
EMBEDDING_BACKEND=hash
# Limits
MAX_UPLOAD_MB=15
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:3000
